<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1D2030"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_anti_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 ما ترفض أن تصير إليه"
        android:textColor="#E0728A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_anti_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:textColor="#E8E6F0"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="end"
        android:text="اكتب رؤيتك المضادة من داخل التطبيق" />

    <TextView
        android:id="@+id/widget_vision_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌱 ما تبنيه"
        android:textColor="#6FA8D8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_vision_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#E8E6F0"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="end"
        android:text="اكتب رؤيتك الأولية من داخل التطبيق" />

</LinearLayout>
